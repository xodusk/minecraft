    "삼지창","바다의 심장","앵무조개 껍데기",
    "음반",
    "마법이 부여된 황금 사과","조각된 호박","엔드 스톤 벽돌",
    "자수정 조각","인갑","거북 등딱지",
    "메아리 파편","화염 저항의 물약","수중 호흡의 물약","투명화 물약",
    "거북 도사의 물약","토끼발","좀비 머리","크리퍼 머리"
  ]
};

const TOTAL_DB = ITEMS.easy.length + ITEMS.medium.length + ITEMS.hard.length;
document.getElementById('dbCount').textContent = TOTAL_DB;

/* ---------------- State ---------------- */
let state = {
  size: 5,
  tiers: { easy: true, medium: true, hard: true },
  free: true,
  board: []
};

/* ---------------- Helpers ---------------- */
function shuffle(arr){
  const a = arr.slice();
  for(let i=a.length-1;i>0;i--){
    const j = Math.floor(Math.random()*(i+1));
    [a[i],a[j]]=[a[j],a[i]];
  }
  return a;
}

function buildPool(){
  let pool = [];
  Object.keys(state.tiers).forEach(t=>{
    if(state.tiers[t]) pool = pool.concat(ITEMS[t].map(n=>({name:n, tier:t})));
  });
  return pool;
}

/* ---------------- Quantity logic ---------------- */
const UNSTACKABLE_PATTERNS = [
  "검","도끼","곡괭이","삽","괭이","활","방패","투구","흉갑","레깅스","부츠","갑옷",
  "물약","지도","끈","이름표","안장","낚싯대","가위","부싯돌과 부시",
  "반향탐지기","비콘","셜커 상자","엔드 수정","용의 알","불사의 토템",
  "삼지창","바다의 심장","나침반","시계",
  "가마솥","베틀","종","대장장이 작업대","숫돌","음반","해골","머리",
  "용의 숨결","엔더의 눈","우유 양동이","양동이","마법이 부여된 책","책과 깃펜","글이 쓰인 책",
  "겉날개","갑옷 거치대","호퍼","광산 수레","보트"
];
function isUnstackable(name){
  return UNSTACKABLE_PATTERNS.some(p => name.includes(p));
}
const QTY_RANGE = { easy:[8,64], medium:[2,32], hard:[1,8] };
function rollQty(name, tier){
  if(isUnstackable(name)) return { qty:1, unit:"개" };
  const [min,max] = QTY_RANGE[tier] || [1,1];
  const qty = Math.floor(Math.random()*(max-min+1))+min;
  return { qty, unit:"개" };
}

const tierLabel = { easy:"쉬움", medium:"보통", hard:"어려움", free:"FREE" };

function generateBoard(){
  const n = state.size;
  const total = n*n;
  const hasFree = state.free && n % 2 === 1;
  const needed = hasFree ? total - 1 : total;

  const pool = shuffle(buildPool());
  const notes = document.getElementById('countNote');

  if(pool.length < needed){
    notes.innerHTML = `<span class="warn">선택한 난이도만으로는 아이템이 ${pool.length}개뿐이라 ${needed}칸을 채울 수 없어요. 난이도를 더 선택해주세요.</span>`;
    return false;
  } else {
    notes.textContent = `사용 가능한 아이템 ${pool.length}개 중 ${needed}개를 무작위로 뽑았어요.`;
  }

  const picked = pool.slice(0, needed).map(it => {
    const q = rollQty(it.name, it.tier);
    return {...it, checked:false, qty:q.qty, unit:q.unit};
  });

  const cells = [];
  let pi = 0;
  const centerIndex = hasFree ? Math.floor(total/2) : -1;
  for(let i=0;i<total;i++){
    if(i === centerIndex){
      cells.push({name:"자유 칸", tier:"free", checked:true, free:true});
    } else {
      cells.push(picked[pi++]);
    }
  }
  state.board = cells;
  return true;
}

function render(){
  const board = document.getElementById('board');
  board.style.gridTemplateColumns = `repeat(${state.size}, 1fr)`;
  board.innerHTML = "";
  state.board.forEach((cell, idx)=>{
    const div = document.createElement('div');
    div.className = 'cell' + (cell.checked ? ' checked':'') + (cell.free ? ' free':'');
    div.dataset.tier = cell.tier;
    div.dataset.idx = idx;
    div.innerHTML = `
      <div class="stratum"></div>
      <div class="tier-label mono">${cell.free ? '' : tierLabel[cell.tier]}</div>
      <div class="name">${cell.name}</div>
      ${cell.free ? '' : `<div class="qty mono">${cell.qty}${cell.unit}</div>`}
    `;
    if(!cell.free){
      div.addEventListener('click', ()=>{
        cell.checked = !cell.checked;
        render();
      });
    }
    board.appendChild(div);
  });
  markWins();
}

function markWins(){
  const n = state.size;
  const cellsEls = Array.from(document.querySelectorAll('.cell'));
  const grid = [];
  for(let r=0;r<n;r++) grid.push(state.board.slice(r*n,(r+1)*n));

  let winLines = [];
  for(let r=0;r<n;r++){
    if(grid[r].every(c=>c.checked)) winLines.push(Array.from({length:n},(_,c)=>r*n+c));
  }
  for(let c=0;c<n;c++){
    let colChecked = true;
    for(let r=0;r<n;r++) if(!grid[r][c].checked) colChecked=false;
    if(colChecked) winLines.push(Array.from({length:n},(_,r)=>r*n+c));
  }
  let d1=true, d2=true;
  for(let i=0;i<n;i++){
    if(!grid[i][i].checked) d1=false;
    if(!grid[i][n-1-i].checked) d2=false;
  }
  if(d1) winLines.push(Array.from({length:n},(_,i)=>i*n+i));
  if(d2) winLines.push(Array.from({length:n},(_,i)=>i*n+(n-1-i)));

  const winIdxSet = new Set(winLines.flat());
  cellsEls.forEach((el,i)=>{
    el.classList.toggle('win-line', winIdxSet.has(i));
  });
  document.getElementById('bingoCount').textContent = winLines.length;
}

/* ---------------- Controls wiring ---------------- */
document.getElementById('sizeSeg').addEventListener('click', e=>{
  const btn = e.target.closest('button');
  if(!btn) return;
  document.querySelectorAll('#sizeSeg button').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active');
  state.size = parseInt(btn.dataset.size,10);
});

document.getElementById('freeSeg').addEventListener('click', e=>{
  const btn = e.target.closest('button');
  if(!btn) return;
  document.querySelectorAll('#freeSeg button').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active');
  state.free = btn.dataset.free === "1";
});

document.querySelectorAll('.tier-chip').forEach(chip=>{
  chip.addEventListener('click', ()=>{
    const t = chip.dataset.tier;
    const activeCount = Object.values(state.tiers).filter(Boolean).length;
    if(state.tiers[t] && activeCount === 1){
      return;
    }
    state.tiers[t] = !state.tiers[t];
    chip.classList.toggle('off', !state.tiers[t]);
  });
});

document.getElementById('genBtn').addEventListener('click', ()=>{
  if(generateBoard()) render();
});

document.getElementById('resetBtn').addEventListener('click', ()=>{
  state.board.forEach(c=>{ if(!c.free) c.checked = false; });
  render();
});

/* ---------------- Init ---------------- */
generateBoard();
render();
</script>
</body>
</html>
